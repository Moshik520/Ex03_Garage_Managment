<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ex03.GarageWebApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Ex03.GarageLogic\**\*.cs"
             Exclude="..\Ex03.GarageLogic\obj\**\*.cs;..\Ex03.GarageLogic\bin\**\*.cs">
      <Link>GarageLogic\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
